{
	"name": "cool-math",
	"version": "1.0.4",
	"description": "A set of very cool math functions for your JS code 😎.",
	"type": "module",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"private": false,
	"repository": {
		"url": "https://github.com/pietro-swe/cool-math"
	},
	"engines": {
		"node": ">=22"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.js"
		},
		"./statistics/*": {
			"types": "./dist/modules/statistics/*.d.mts",
			"default": "./dist/modules/statistics/*.js"
		},
		"./guards/*": {
			"types": "./dist/modules/guards/*.d.mts",
			"default": "./dist/modules/guards/*.js"
		},
		"./safety/*": {
			"types": "./dist/modules/safety/*.d.mts",
			"default": "./dist/modules/safety/*.js"
		},
		"./advanced/*": {
			"types": "./dist/modules/advanced/*.d.mts",
			"default": "./dist/modules/advanced/*.js"
		},
		"./arithmetic/*": {
			"types": "./dist/modules/arithmetic/*.d.mts",
			"default": "./dist/modules/arithmetic/*.js"
		},
		"./collections/*": {
			"types": "./dist/modules/collections/*.d.mts",
			"default": "./dist/modules/collections/*.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"keywords": [
		"math",
		"mathematics",
		"functions",
		"mathematical functions",
		"cool"
	],
	"types": "dist/index.d.mts",
	"sideEffects": false,
	"scripts": {
		"test": "vitest",
		"build": "npm run build:js && npm run build:types",
		"build:js": "tsup",
		"build:types": "tsc"
	},
	"author": {
		"name": "Pietro Piva Vieira",
		"email": "pietro.developer@gmail.com"
	},
	"license": "MIT",
	"devDependencies": {
		"tsup": "^8.5.1",
		"typescript": "^5.9.3"
	}
}
