{
	"name": "cool-math",
	"version": "1.0.3",
	"description": "A set of very cool math functions for your JS code 😎.",
	"type": "module",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"private": false,
	"repository": {
		"url": "https://github.com/pietro-swe/cool-math"
	},
	"engines": {
		"node": ">=22"
	},
	"exports": {
		".": "./dist/index.js",
		"./statistics/*": "./dist/modules/statistics/*",
		"./guards/*": "./dist/modules/guards/*",
		"./safety/*": "./dist/modules/safety/*",
		"./advanced/*": "./dist/modules/advanced/*",
		"./arithmetic/*": "./dist/modules/arithmetic/*",
		"./collections/*": "./dist/modules/collections/*"
	},
	"files": [
		"dist",
		"README.md"
	],
	"keywords": [
		"math",
		"mathematics",
		"functions",
		"mathematical functions",
		"cool"
	],
	"types": "dist/index.d.mts",
	"sideEffects": false,
	"scripts": {
		"test": "vitest",
		"build": "npm run build:js && npm run build:types",
		"build:js": "tsup",
		"build:types": "tsc"
	},
	"author": {
		"name": "Pietro Piva Vieira",
		"email": "pietro.developer@gmail.com"
	},
	"license": "MIT",
	"devDependencies": {
		"tsup": "^8.5.1",
		"typescript": "^5.9.3"
	}
}
